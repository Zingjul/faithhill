# =====================================================================
# Faith Hill API — environment variables
# =====================================================================
# Copy this file to backend/faithhill/.env
#
#   cd backend/faithhill
#   cp ../.env.example .env
#   # then edit .env and load it:
#   set -a; source .env; set +a
#
# For LOCAL development you can skip this file entirely — with no variables
# set the API runs on SQLite, stores uploads in backend/faithhill/media/,
# and uses DEBUG=True.
#
# On RENDER you don't use this file: paste the same keys into
# Dashboard -> your service -> Environment. See DEPLOYMENT.md §9.
#
# ── Required in production (the app refuses to boot without these) ───
#   DEBUG=False, SECRET_KEY, DATABASE_URL
# ── Required for uploads to survive a redeploy ───────────────────────
#   SUPABASE_PROJECT_REF, SUPABASE_SERVICE_KEY
# ── Required for the browser to reach the API ────────────────────────
#   ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS, CSRF_TRUSTED_ORIGINS
# =====================================================================


# ---------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------

# True = local development (verbose errors, SQLite allowed, no HTTPS
# enforcement). MUST be False in production.
# Default: True
DEBUG=True

# Django's cryptographic signing key. Render generates one automatically
# for the blueprint; anywhere else, generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required when DEBUG=False.
# SECRET_KEY=

# Comma-separated hostnames Django will answer for. The scheme and port
# must NOT be included.
# Default locally: localhost,127.0.0.1,.e2b.app
# ALLOWED_HOSTS=faith-hill-api.onrender.com,faithhill.org,www.faithhill.org


# ---------------------------------------------------------------------
# DATABASE — Supabase Postgres
# ---------------------------------------------------------------------
# Supabase dashboard -> Connect -> "Connection pooling" -> SESSION mode.
# It looks like:
#   postgresql://postgres.abcdefghijklmnop:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Use SESSION mode (port 5432), not Transaction mode (port 6543):
# Django holds long-lived connections and prepared statements, which
# transaction pooling breaks.
#
# Omit this entirely for local development to use SQLite.
# Required when DEBUG=False.
# DATABASE_URL=

# Supabase's pooler uses a TLS certificate that needs verification, so SSL
# is required by default. Only set this to True if you are intentionally
# connecting to a non-TLS Postgres (e.g. a local container).
# Default: False
# DATABASE_SSL_DISABLE=False

# Escape hatch: allow SQLite to be used even with DEBUG=False.
# Leave this unset in production — a Render container's filesystem is
# wiped on every deploy, so SQLite there silently loses all content.
# ALLOW_SQLITE_IN_PRODUCTION=1


# ---------------------------------------------------------------------
# IMAGE STORAGE — Supabase Storage
# ---------------------------------------------------------------------
# Only needed in production. Without BOTH of the next two variables,
# uploads fall back to local disk (backend/faithhill/media/), which is
# fine locally but vanishes on every Render redeploy.
#
# Find the project ref in the project URL:
#   https://abcdefghijklmnop.supabase.co  ->  abcdefghijklmnop
# SUPABASE_PROJECT_REF=

# Project Settings -> API -> "service_role" secret.
# WARNING: this key bypasses all row-level security. Server-side only.
# Never put it in a frontend, never commit it.
# SUPABASE_SERVICE_KEY=

# Bucket name. Must already exist in Storage and be marked PUBLIC,
# otherwise uploaded images 404 for visitors.
# Default: faithhill-media
# SUPABASE_BUCKET=faithhill-media

# Optional dedicated S3 credentials (Storage -> S3 access keys). If you
# create them, set the access key here; otherwise the project ref is used
# as the access key id.
# SUPABASE_ACCESS_KEY=

# Region for the S3 endpoint. Supabase still expects us-east-1 for
# signing even when the project lives elsewhere — change only if Supabase
# tells you to.
# Default: us-east-1
# SUPABASE_REGION=us-east-1


# ---------------------------------------------------------------------
# BROWSER ACCESS — CORS & CSRF
# ---------------------------------------------------------------------
# Origins allowed to call the API from a browser. Comma-separated, WITH
# the scheme, no trailing slash. Miss one and the browser blocks the
# request with a CORS error while curl still works.
#
# Default locally: localhost:5173, localhost:5174, 127.0.0.1:5173, 127.0.0.1:5174
# CORS_ALLOWED_ORIGINS=https://faithhill.org,https://www.faithhill.org,https://fh-staff-console.onrender.com

# Origins trusted for CSRF checks (Django admin login). Use the same
# values as CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=https://faithhill.org,https://www.faithhill.org,https://fh-staff-console.onrender.com

# Extra CORS origins, appended to CORS_ALLOWED_ORIGINS. Handy for a
# temporary preview domain without editing the main list.
# CORS_EXTRA_ORIGINS=https://faithhill-preview.onrender.com


# ---------------------------------------------------------------------
# RATE LIMITS — brute-force protection
# ---------------------------------------------------------------------
# Login attempts per IP. Format: "N/period" where period is
# second/minute/hour/day.
# Default: 10/min
# THROTTLE_LOGIN=10/min

# Visitor form submissions (prayer/contact/newsletter/RSVP) per IP.
# Default: 30/hour
# THROTTLE_SUBMIT=30/hour


# ---------------------------------------------------------------------
# SECURITY TUNING (only applied when DEBUG=False)
# ---------------------------------------------------------------------
# Redirect all HTTP to HTTPS. Render terminates TLS at its proxy and
# forwards X-Forwarded-Proto, which the app already trusts.
# Default: True
# SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security duration in seconds.
# Default: 31536000 (1 year)
# Set to 0 while testing a fresh domain if you need to undo HSTS quickly.
# SECURE_HSTS_SECONDS=31536000


# ---------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------
# Root log level: DEBUG, INFO, WARNING, ERROR.
# Default: INFO
# LOG_LEVEL=INFO


# ---------------------------------------------------------------------
# RENDER-PROVIDED — do not set these manually
# ---------------------------------------------------------------------
# Render injects RENDER_EXTERNAL_HOSTNAME automatically and the app adds
# it to ALLOWED_HOSTS. Only relevant if you fork away from Render.
# RENDER_EXTERNAL_HOSTNAME=faith-hill-api.onrender.com

# Render supplies PORT and the build script/start command use it.
# PORT=10000

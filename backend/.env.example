# Faith Hill API — copy to backend/faithhill/.env for local development.
# Everything below is OPTIONAL locally: without it the API uses SQLite,
# local /media storage, and DEBUG=True.

# --- Core ---------------------------------------------------------------
# DEBUG=True
# SECRET_KEY=any-long-random-string-when-debug-is-false
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Supabase Postgres) --------------------------------------
# Session-pooler URI from Supabase -> Connect -> Connection pooling.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Image storage (Supabase Storage) ----------------------------------
# Without these two, uploads go to local backend/faithhill/media/.
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_SERVICE_KEY=service-role-key-goes-here
# SUPABASE_BUCKET=faithhill-media

# --- Security / limits --------------------------------------------------
# CORS_ALLOWED_ORIGINS=https://faithhill.org,https://www.faithhill.org
# CSRF_TRUSTED_ORIGINS=https://faithhill.org,https://www.faithhill.org
# THROTTLE_LOGIN=10/min
# THROTTLE_SUBMIT=30/hour

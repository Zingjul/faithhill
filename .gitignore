# ======================================================================
# Faith Hill Church Platform — root .gitignore
# Covers: Django backend, React/Vite frontends, tooling, editors, OS junk
# ======================================================================

# ---------- Python / Django ----------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
wheels/
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/

# Django runtime artifacts (dev database, uploads, collected statics)
db.sqlite3
db.sqlite3-journal
backend/faithhill/media/*
!backend/faithhill/media/.gitkeep
backend/faithhill/staticfiles/
local_settings.py

# Testing / coverage (Python)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checkers / linters (Python)
.mypy_cache/
.ruff_cache/

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example
!.env.sample
*.pem

# ---------- Node / React / Vite ----------
node_modules/
dist/
dist-ssr/
*.local

# Build caches
.cache/
.parcel-cache/
.turbo/
.eslintcache
*.tsbuildinfo

# Testing / coverage (JS)
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Editors & IDEs ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ---------- Operating system ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------- Misc ----------
*.bak
*.tmp
*.orig

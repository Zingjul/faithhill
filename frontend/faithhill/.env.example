# =====================================================================
# Faith Hill PUBLIC WEBSITE — environment variables
# =====================================================================
# Copy to frontend/faithhill/.env for local overrides.
#
# ⚠️ IMPORTANT: VITE_* variables are compiled into the JavaScript bundle at
# BUILD time — they are NOT read at runtime. Changing one on Render does
# nothing until you REDEPLOY (rebuild) that static site. Never put a secret
# here; anything prefixed VITE_ is visible to every visitor.
# =====================================================================

# Base URL of the Django API.
#
# Local development: LEAVE THIS UNSET. The Vite dev proxy forwards /api to
# http://localhost:8000, so requests stay same-origin and no CORS is needed.
#
# Production: set it to the API's public origin, no trailing slash.
# VITE_API_URL=https://faith-hill-api.onrender.com

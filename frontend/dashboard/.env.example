# =====================================================================
# Faith Hill STAFF CONSOLE — environment variables
# =====================================================================
# Copy to frontend/dashboard/.env for local overrides.
#
# ⚠️ IMPORTANT: VITE_* variables are compiled into the JavaScript bundle at
# BUILD time — they are NOT read at runtime. Changing one on Render does
# nothing until you REDEPLOY (rebuild) that static site.
#
# ⚠️ Never put a secret here. Everything prefixed VITE_ ships to the browser.
# Staff authentication is a password + JWT issued by the API — not a key
# hidden in this file.
# =====================================================================

# Base URL of the Django API.
#
# Local development: LEAVE THIS UNSET. The Vite dev proxy forwards /api to
# http://localhost:8000.
#
# Production: the API's public origin, no trailing slash.
# VITE_API_URL=https://faith-hill-api.onrender.com

# The URL path the console is served from. Set this to something long and
# random so the staff area isn't sitting at a guessable /admin.
#
# Pick your own string — don't reuse this example. Must start and end with
# a slash.
#
#   /fh-console-7x2k9/
#
# Staff then bookmark https://<your-staff-site>/fh-console-7x2k9/
#
# Be clear on what this does: it keeps the door out of casual scanning. It
# is NOT the security. Every /api/manage/ request still requires a valid
# JWT for an account with is_staff, and login is rate-limited.
#
# Default: / (served at the site root — fine for local development)
# VITE_BASE_PATH=/fh-console-7x2k9/
